          "2PR",
          "0",
          "1",
          "0"
        ],
        [
          "Aa $ \\times $ Aa",
          "$ Q^{2} $",
          "$ \\frac{1}{4} $",
          "$ \\frac{1}{2} $",
          "$ \\frac{1}{4} $"
        ],
        [
          "Aa $ \\times $ aa",
          "2QR",
