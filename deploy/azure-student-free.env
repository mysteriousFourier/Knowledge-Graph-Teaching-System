# Non-secret overrides for the existing ~1 GB Azure for Students VM.
# Load after the site's own .env in systemd. Keep API keys in that .env.
APP_BIND_HOST=127.0.0.1
APP_RUNTIME_DIR=.runtime
GRAPH_DB_PATH=.runtime/knowledge_graph.db
APP_BOOTSTRAP_SEED_DATA=1
APP_RUN_STARTUP_MAINTENANCE=0
RENDER_AUTO_SYNC_STRUCTURED=0
KGTS_RETRIEVAL_MODE=sparse_hybrid
KGTS_RAG_CONTEXT_CHARS=12000
# Persistent bounded cache for repeated GraphRAG context assembly.
KGTS_CONTEXT_CACHE_ENABLED=1
KGTS_CONTEXT_CACHE_DIR=.runtime/context-cache
KGTS_CONTEXT_CACHE_MAX_ENTRIES=128
KGTS_CONTEXT_CACHE_TTL_SECONDS=3600
KGTS_CONTEXT_CACHE_MAX_BYTES=33554432
KGTS_VECTOR_STARTUP_ENSURE=0
KGTS_VECTOR_UNLOAD_AFTER_QUERY=1
KGTS_VECTOR_UNLOAD_AFTER_REBUILD=1
KGTS_VECTOR_HASH_FALLBACK=1
# Inherit the site's TTS provider and URL (Azure Speech or a separate proxy).
# Do not configure a local neural TTS model in the web process on this VM.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false
MALLOC_ARENA_MAX=2
PYTHONUNBUFFERED=1
