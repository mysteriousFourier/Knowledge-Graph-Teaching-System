          "1"
        ],
        [
          "",
          "Totals (next generation)",
          "$ P' $",
          "$ Q' $",
          "$ R' $"
        ],
        [
          "therefore",
          "$ P'=P^{2}+\\frac{2PQ}{2}+\\frac{Q^{2}}{4}=(P+\\frac{Q}{2})^{2}=p^{2} $"
